# API mode: mock for UI/contract tests, clip for local Batch 1 retrieval.
AIC_ENGINE=mock

# Required when AIC_ENGINE=clip.
AIC_DB_PATH=./database/aic2026.sqlite
AIC_CLIP_INDEX=./indexes/clip/frame.faiss
AIC_CLIP_MAPPING=./indexes/clip/frame_mapping.json
AIC_CLIP_MODEL=openai/clip-vit-base-patch32
AIC_DEVICE=auto

# Optional QA VLM. Select only after benchmarking on the AIC QA set.
# AIC_VLM_MODEL=<benchmarked-image-text-model>
# AIC_VLM_DEVICE=auto
