# Local paths
AIC_DATA_ROOT=./data
AIC_DATABASE_PATH=./database/aic2026.sqlite
AIC_CLIP_INDEX_PATH=./indexes/clip/frame.faiss
AIC_CLIP_MAPPING_PATH=./indexes/clip/frame_mapping.json

# API/UI
AIC_API_BASE_URL=http://127.0.0.1:8000

# Runtime
AIC_ENV=development
AIC_LOG_LEVEL=INFO

# Optional model-based semantic reranking
# Disabled by default so baseline/CI never downloads a checkpoint.
AIC_SEMANTIC_RERANK_ENABLED=false
AIC_SEMANTIC_RERANK_MODEL=google/siglip2-base-patch16-256
AIC_SEMANTIC_RERANK_CANDIDATES=50
AIC_SEMANTIC_RERANK_WEIGHT=0.15
